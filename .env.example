# Copy to .env and fill in. Never commit real values.

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# X (Twitter) sign-in, OAuth 2.0
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=

# Smart Readiness data source (TwitterAPI.io). Leave READINESS_PROVIDER empty to use the built-in fake data in development.
TWITTERAPI_IO_KEY=
READINESS_PROVIDER=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# Cloudflare R2 uploads
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Content analysis
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
RAPIDAPI_KEY=

# Payouts
BASE_RPC_URL=
TREASURY_PRIVATE_KEY=
